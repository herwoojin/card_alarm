# ─────────────────────────────────────────────────────────────
# Firebase (선택) — 구글 로그인 + 클라우드 백업을 쓸 때만 채운다.
# 비워 두면 앱은 지금처럼 100% 로컬로 동작하고 외부 요청 0건을 유지한다.
#
# 이 값들은 "비밀"이 아니다(웹 Firebase 설정은 공개값). 실제 보안은 Storage 보안 규칙이 강제한다.
# Firebase 콘솔 → 프로젝트 설정 → "내 앱"(웹) → SDK 설정 및 구성 에서 복사.
#
# 로컬: 이 파일을 .env.local 로 복사해 채운다.
# Netlify: Site settings → Environment variables 에 같은 키로 등록.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 문자 자동 수신함(무료)을 쓸 때만. Realtime Database 생성 후 콘솔에 표시되는 URL을 넣는다.
# 예: https://card-alarm-service-default-rtdb.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# ─── Netlify Function(웹훅)용 서버 시크릿 — Netlify 환경변수에만 넣는다(커밋 금지) ───
# 서비스 계정 키가 조직 정책으로 막혀도 되는 방식: RTDB 데이터베이스 시크릿 사용.
# FIREBASE_DB_URL    = 위 NEXT_PUBLIC_FIREBASE_DATABASE_URL 과 동일한 값
# FIREBASE_DB_SECRET = Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → "데이터베이스 비밀번호"의 시크릿
